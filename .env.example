# Unique per application: these keep Compose projects and Traefik routers
# from colliding with other apps on the same machine/proxy.
APP_SLUG=becks-clay
COMPOSE_PROJECT_NAME=becks-clay

# Required PostgreSQL namespace for this application. Use lowercase snake_case;
# keep this stable even if APP_SLUG or the public domain changes later.
DB_SCHEMA=becks_clay

# Shared Traefik network and entrypoints (already used by sibling apps).
TRAEFIK_NETWORK=proxy-net
TRAEFIK_DEV_ENTRYPOINT=web
TRAEFIK_PROD_ENTRYPOINT=websecure
TRAEFIK_PROD_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=letsencrypt

# Same-origin API routing; keep /api.
REACT_APP_API_BASE_URL=/api

# Unique local hostname. Do not use bare `localhost`; another app may own it.
DEV_APP_DOMAIN=becksclay.localhost
APP_DOMAIN=becksclay.gravvisoft.com
APP_ALIAS_DOMAIN=beckclay.gravvisoft.com
CORS_ORIGINS=https://becksclay.gravvisoft.com,http://becksclay.localhost

FLASK_ENV=development
FLASK_DEBUG=1
APP_SECRET_KEY=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=86400

CONNECTION_STRING=postgresql://app_user:replace-me@host.docker.internal:5432/app_db
# Optional separate development database. When set, docker-compose.dev.yml
# points the dev backend and dev jobs at it instead of CONNECTION_STRING.
DEV_CONNECTION_STRING=

# Private Discord destination shared by every host-side cron failure alert.
# Put the real value only in the untracked server .env.
AUTOMATION_FAILURE_DISCORD_WEBHOOK_URL=
# Optional canonical users.id allowed to set the gallery-wide featured model.
CLAY_GALLERY_OWNER_USER_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
# Enable only after the R2 CORS policy allows GET from the gallery origins.
CLAY_GALLERY_DIRECT_WEB_MODELS=0
CLAY_GALLERY_MODEL_MAX_MB=250
