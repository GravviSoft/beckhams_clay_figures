FROM node:20-alpine
WORKDIR /app

ARG REACT_APP_API_BASE_URL=/api
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL

# Dependencies are installed only here, from the committed lockfile.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY public ./public
COPY src ./src

EXPOSE 3000
CMD ["npm", "start"]
