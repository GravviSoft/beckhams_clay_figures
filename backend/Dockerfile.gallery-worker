FROM node:22-bookworm-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/gallery/bin:${PATH}"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends blender python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global gltfpack@1.3.0 \
    && python3 -m venv /opt/gallery
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
USER node
CMD ["python", "scripts/prepare_gallery_web_assets.py"]
